# =============================================================================
# nationa — environment configuration reference
# =============================================================================
#
# This file is a REFERENCE ONLY. It is not loaded by any app.
#
# Where does each file go?
#   - .env.example (this file) ............ canonical inventory of every var.
#   - apps/web/.env ....................... Nuxt public vars (NUXT_PUBLIC_*).
#   - apps/server/.env .................... Hono/Worker vars (secrets + public).
#   - packages/db/.env .................... DATABASE_URL for Drizzle scripts.
#   - packages/infra/.env ................. ALCHEMY_PASSWORD + deploy inputs.
#   - root .env ........................... optional; used by root db:/deploy
#                                           scripts (same values as server/db).
#
# Copy the per-app templates:
#   cp apps/web/.env.example apps/web/.env
#   cp apps/server/.env.example apps/server/.env
#   cp packages/db/.env.example packages/db/.env
#
# Varlock loads each app's .env.schema and validates the matching .env.
# After editing a schema run: pnpm run env:generate
# Never commit real .env files or real secrets. Placeholders below are safe.
# =============================================================================


# -----------------------------------------------------------------------------
# Web (Nuxt, public)
# Destination: apps/web/.env
# These are exposed to the browser via NUXT_PUBLIC_* — never put secrets here.
# -----------------------------------------------------------------------------

# PUBLIC — "development" | "production" | "test". Controls Varlock's active env.
NODE_ENV=development

# PUBLIC — Absolute URL of the Hono server used by the browser/SSR fetches.
# Local default: http://localhost:3000. Get it from your Alchemy deploy output.
NUXT_PUBLIC_SERVER_URL=http://localhost:3000

# PUBLIC — Supabase project/API URL. Local Supabase: http://127.0.0.1:54321.
# Hosted: Supabase dashboard → Project Settings → API → Project URL.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# PUBLIC (publishable, still not a server secret) — Supabase anon/publishable key.
# Local: `supabase status` prints the anon key. Hosted: Project Settings → API.
NUXT_PUBLIC_SUPABASE_KEY=replace-with-local-publishable-key


# -----------------------------------------------------------------------------
# Server (Hono)
# Destination: apps/server/.env
# -----------------------------------------------------------------------------

# PUBLIC — "development" | "production" | "test". Must match the web app value.
NODE_ENV=development

# PUBLIC — Exact allowed browser origin for CORS. Local web dev: http://localhost:3001.
# In production set the deployed web origin (e.g. https://app.example.com).
CORS_ORIGIN=http://localhost:3001

# SECRET — OpenRouter API key. Get it from https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# PUBLIC (optional) — OpenRouter model id. Defaults to qwen/qwen3.7-flash.
OPENROUTER_MODEL=qwen/qwen3.7-flash

# SECRET — PostgreSQL connection string used by Drizzle and the server.
# Local Supabase DB: postgresql://postgres:postgres@127.0.0.1:54322/postgres.
# Hosted: Supabase dashboard → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres


# -----------------------------------------------------------------------------
# Supabase (server-side auth)
# Destination: apps/server/.env
# -----------------------------------------------------------------------------

# PUBLIC — Supabase API URL used to derive the auth issuer/JWKS endpoint.
# Same value as NUXT_PUBLIC_SUPABASE_URL: http://127.0.0.1:54321 locally.
SUPABASE_URL=http://127.0.0.1:54321

# PUBLIC (optional) — JWKS endpoint for JWT verification. Defaults to
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json when unset.
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# SECRET (optional) — Legacy symmetric (HS256) Supabase JWT secret used as a
# fallback when JWKS verification fails. Legacy projects only.
SUPABASE_JWT_SECRET=


# -----------------------------------------------------------------------------
# Cloudflare R2 (server-side object storage)
# Destination: apps/server/.env
# Get these from Cloudflare dashboard → R2 → Manage R2 API Tokens.
# In production the Worker uses the DOCUMENTS_BUCKET binding set by Alchemy;
# these vars are the local/S3-client equivalents.
# -----------------------------------------------------------------------------

# PUBLIC — Name of the R2 bucket that holds documents.
R2_BUCKET_NAME=nationa-documents-dev

# PUBLIC — Cloudflare account ID (dashboard URL or `wrangler whoami`).
R2_ACCOUNT_ID=your-cloudflare-account-id

# SECRET — R2 S3-compatible access key ID.
R2_ACCESS_KEY_ID=

# SECRET — R2 S3-compatible secret access key.
R2_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# AI / OpenRouter
# (OPENROUTER_API_KEY and OPENROUTER_MODEL are declared in the server schema
# and listed under "Server (Hono)" above. Destination: apps/server/.env.)
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Deploy / Infra
# Destination: packages/infra/.env (and/or root .env for root deploy scripts)
# -----------------------------------------------------------------------------

# SECRET — Alchemy state/profile encryption password. Required for `alchemy
# deploy` / `alchemy destroy`. Generate any strong random string, e.g.:
#   openssl rand -base64 32
ALCHEMY_PASSWORD=

# SECRET — Optional Varlock key for decrypting encrypted values in .env files.
# Only needed when using Varlock encrypted secrets; listed in turbo globalEnv.
# _VARLOCK_ENV_KEY=


# -----------------------------------------------------------------------------
# Platform-provided (do not commit)
# Injected automatically by the hosting/CI platform; listed in turbo globalEnv.
# -----------------------------------------------------------------------------

# CI=                         # set by the CI provider (e.g. true)
