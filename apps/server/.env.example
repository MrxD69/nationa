# apps/server/.env — copy to .env and fill in real values.
# Vars must match apps/server/.env.schema. Regenerate types: pnpm run env:generate
# Secret values belong only in this file, never in apps/web/.env.

# PUBLIC — "development" | "production" | "test".
NODE_ENV=development

# PUBLIC — Exact allowed browser origin for CORS. Local web dev: http://localhost:3001.
# Production: the deployed web origin (e.g. https://app.example.com).
CORS_ORIGIN=http://localhost:3001

# SECRET — OpenRouter API key. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# PUBLIC (optional) — OpenRouter model id. Defaults to qwen/qwen3.7-flash.
OPENROUTER_MODEL=qwen/qwen3.7-flash

# SECRET — PostgreSQL connection string.
# Local Supabase DB: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct local (54322) OK with pool max:5. Prod Supabase MUST use pooler 6543?pgbouncer=true + prepare:false.
# Never raise max>10 on direct connections — exceeds Postgres max_connections fast (EMAXCONN).
# Double dev servers stack pools — one dev:local only (EADDRINUSE guard in src/dev.ts).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# PUBLIC — Supabase API URL. Local: http://127.0.0.1:54321.
SUPABASE_URL=http://127.0.0.1:54321

# PUBLIC (optional) — defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# SECRET (optional) — Legacy symmetric (HS256) Supabase JWT secret used as a
# fallback when JWKS verification fails. Legacy projects only.
SUPABASE_JWT_SECRET=

# PUBLIC — R2 bucket name (Cloudflare dashboard → R2).
R2_BUCKET_NAME=nationa-documents-dev

# PUBLIC — Cloudflare account ID.
R2_ACCOUNT_ID=your-cloudflare-account-id

# SECRET — R2 S3-compatible credentials (Cloudflare → R2 → Manage R2 API Tokens).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
