{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev:bare": "bun --watch src/dev.ts",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.15",
    "@nationa/api": "workspace:*",
    "@nationa/db": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "ai": "catalog:",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@nationa/config": "workspace:*",
    "@nationa/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
