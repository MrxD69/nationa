# apps/web/.env — copy to .env and fill in real values.
# Vars must match apps/web/.env.schema. Regenerate types: pnpm run env:generate
# NUXT_PUBLIC_* are exposed to the browser; never put secrets here.

# PUBLIC — "development" | "production" | "test".
NODE_ENV=development

# PUBLIC — URL of the Hono server (browser + SSR). Local: http://localhost:3000.
# Hosted: Alchemy deploy output (server worker URL).
NUXT_PUBLIC_SERVER_URL=http://localhost:3000

# PUBLIC — Supabase API URL. Local: http://127.0.0.1:54321.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# PUBLIC — Supabase anon/publishable key (`supabase status` locally;
# hosted: Supabase dashboard → Project Settings → API).
NUXT_PUBLIC_SUPABASE_KEY=replace-with-local-publishable-key
