{
  "name": "nationa",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "postinstall": "tsc -b packages/api && varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "dev:types": "tsc -b packages/api --watch",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:server": "turbo run dev:bare -F server --",
    "db:push": "turbo run db:push -F @nationa/db --",
    "db:seed": "turbo run db:seed -F @nationa/db --",
    "db:studio": "turbo run db:studio -F @nationa/db --",
    "db:generate": "turbo run db:generate -F @nationa/db --",
    "db:migrate": "turbo run db:migrate -F @nationa/db --",
    "deploy": "turbo run deploy -F @nationa/infra --",
    "destroy": "turbo run destroy -F @nationa/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@nationa/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@vue/devtools-api": "^8.2.1"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
