# packages/db/.env — copy to .env and fill in real values.
# Used by Drizzle scripts (drizzle.config.ts) and db code.
# Vars are imported from apps/server/.env.schema (pick: NODE_ENV, DATABASE_*).
# Keep this in sync with DATABASE_URL in apps/server/.env.

# PUBLIC — "development" | "production" | "test".
NODE_ENV=development

# SECRET — PostgreSQL connection string.
# Local Supabase DB: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: Supabase dashboard → Project Settings → Database → Connection string.
# Direct local (54322) OK with pool max:5. Prod Supabase MUST use pooler 6543?pgbouncer=true + prepare:false.
# Never raise max>10 on direct connections — exceeds Postgres max_connections fast (EMAXCONN).
# Double dev servers stack pools — one dev:local only (EADDRINUSE guard in apps/server/src/dev.ts).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
